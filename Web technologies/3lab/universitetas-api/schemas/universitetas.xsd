<?xml version="1.0" encoding="UTF-8"?>
<!--
  Universiteto XML Schema (1lab.xml struktūrai).
  https://www.vu.lt/universitetas (prefiksas uni, kuris naudojamas dėl patogumo ir konfliktų prevencijos).
  Erasmus elementai yra kitoje vardų srityje, aprašyti erasmus.xsd.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:uni="https://www.vu.lt/universitetas"
           xmlns:erasmus="https://erasmus-plus.ec.europa.eu/lt/about-erasmus"
           targetNamespace="https://www.vu.lt/universitetas"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

  <xs:import namespace="https://erasmus-plus.ec.europa.eu/lt/about-erasmus"
             schemaLocation="erasmus.xsd"/>

  <xs:simpleType name="PastoKodasType">
    <xs:restriction base="xs:string">
      <xs:pattern value="LT-\d{5}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="DalykoKodasType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Z]{2,3}-\d{3}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="LygisType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="bakalauras"/>
      <xs:enumeration value="magistras"/>
      <xs:enumeration value="doktorantura"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="LaipsnisType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="prof. dr."/>
      <xs:enumeration value="habil. dr."/>
      <xs:enumeration value="doc. dr."/>
      <xs:enumeration value="dr."/>
      <xs:enumeration value="lekt."/>
      <xs:enumeration value="prakt."/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="KreditaiType">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="1"/>
      <xs:maxInclusive value="60"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="MetaiType">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="1900"/>
      <xs:maxInclusive value="2100"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="VidurkioReiksmeType">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="1"/>
      <xs:maxInclusive value="10"/>
      <xs:fractionDigits value="2"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PazymysType">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="1"/>
      <xs:maxInclusive value="10"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PazymiuSarasasType">
    <xs:list itemType="uni:PazymysType"/>
  </xs:simpleType>

  <xs:complexType name="VidurkisType">
    <xs:simpleContent>
      <xs:extension base="uni:VidurkioReiksmeType">
        <xs:attribute name="ataskaitosMetai" type="uni:MetaiType"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="PatvirtintasVidurkisType">
    <xs:simpleContent>
      <xs:restriction base="uni:VidurkisType">
        <xs:minInclusive value="5"/>
        <xs:attribute name="ataskaitosMetai" type="uni:MetaiType"
                      use="required"/>
      </xs:restriction>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="VidurkisSuStudentaisType">
    <xs:simpleContent>
      <xs:extension base="uni:VidurkisType">
        <xs:attribute name="studentuSkaicius" type="xs:positiveInteger"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="AsmuoType">
    <xs:sequence>
      <xs:element name="vardas"   type="xs:string"/>
      <xs:element name="pavarde"  type="xs:string"/>
      <xs:element name="elpastas" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="VardasPavardeType">
    <xs:complexContent>
      <xs:restriction base="uni:AsmuoType">
        <xs:sequence>
          <xs:element name="vardas"  type="xs:string"/>
          <xs:element name="pavarde" type="xs:string"/>
        </xs:sequence>
      </xs:restriction>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="DestytojasType">
    <xs:complexContent>
      <xs:extension base="uni:AsmuoType">
        <xs:sequence>
          <xs:element name="katedra" type="xs:string" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="laipsnis" type="uni:LaipsnisType" use="required"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="AprasymasType" mixed="true">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="miestas"            type="xs:string"/>
      <xs:element name="metai"              type="uni:MetaiType"/>
      <xs:element name="studentu_skaicius"  type="xs:positiveInteger"/>
    </xs:choice>
  </xs:complexType>

  <xs:complexType name="AdresasType">
    <xs:sequence>
      <xs:element name="gatve"       type="xs:string"/>
      <xs:element name="miestas"     type="xs:string"/>
      <xs:element name="pasto_kodas" type="uni:PastoKodasType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ButinasDalykasType">
    <xs:attribute name="kodas" type="uni:DalykoKodasType" use="required"/>
  </xs:complexType>

  <xs:complexType name="DalykasType">
    <xs:sequence>
      <xs:element name="dalyko_pavadinimas" type="xs:string"/>
      <xs:element name="destytojas"         type="uni:DestytojasType"/>
      <xs:element name="kreditai"           type="uni:KreditaiType"/>
      <xs:element name="studentu_pazymiu_vidurkis"
                  type="uni:VidurkisSuStudentaisType"/>

      <xs:choice minOccurs="0">
        <xs:element name="egzamino_pazymiai" type="uni:PazymiuSarasasType"/>
        <xs:element name="ikaitis"           type="xs:boolean"/>
      </xs:choice>

      <xs:element name="butinas_dalykas" type="uni:ButinasDalykasType"
                  minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="kodas" type="uni:DalykoKodasType" use="required"/>
  </xs:complexType>

  <xs:complexType name="ProgramaType">
    <xs:sequence>
      <xs:element name="studiju_programos_pavadinimas" type="xs:string"/>
      <xs:element ref="erasmus:partneris" minOccurs="0"/>
      <xs:element name="programos_vidurkis" type="uni:PatvirtintasVidurkisType"
                  minOccurs="0"/>
      <xs:element name="dalykas" type="uni:DalykasType"
                  maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="lygis" type="uni:LygisType" use="required"/>
  </xs:complexType>

  <xs:complexType name="FakultetasType">
    <xs:sequence>
      <xs:element name="fakulteto_pavadinimas"    type="xs:string"/>
      <xs:element name="fakulteto_isteigimo_data" type="xs:date"/>
      <xs:element name="adresas"   type="uni:AdresasType"/>
      <xs:element name ="id"       type="xs:positiveInteger"/>
      <xs:element name="dekanas"   type="uni:VardasPavardeType" minOccurs="0"/>
      <xs:element name="aprasymas" type="uni:AprasymasType"     minOccurs="0"/>
      <xs:element name="programa"  type="uni:ProgramaType"
                  maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="UniversitetasType">
    <xs:sequence>
      <xs:element name="universiteto_pavadinimas" type="xs:string"/>
      <xs:element name="fakultetas" type="uni:FakultetasType"
                  maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="universitetas" type="uni:UniversitetasType">

    <xs:unique name="fakultetasUnique">
      <xs:selector xpath="uni:fakultetas"/>
      <xs:field xpath="@id"/>
    </xs:unique>

    <xs:key name="dalykasKey">
      <xs:selector xpath="uni:fakultetas/uni:programa/uni:dalykas"/>
      <xs:field xpath="@kodas"/>
    </xs:key>

    <xs:keyref name="butinasDalykasRef" refer="uni:dalykasKey">
      <xs:selector
          xpath="uni:fakultetas/uni:programa/uni:dalykas/uni:butinas_dalykas"/>
      <xs:field xpath="@kodas"/>
    </xs:keyref>
  </xs:element>

</xs:schema>
